# Keep loopback for local access or set the server's VPN IP for remote access.
RX_HOST=127.0.0.1
RX_PORT=8787
# Optional comma-separated hostnames used to access the ledger.
RX_ALLOWED_HOSTS=
# Point this to the existing directory containing ledger.db when migrating.
RX_DATA_DIR=./data
# Optional: store the ledger in Postgres instead of SQLite (backups still go to RX_DATA_DIR/backups).
# Put the password in ~/.pgpass (chmod 600), not in this URL.
# RX_DATABASE_URL=postgresql://rx_ledger@10.137.203.1:5432/rx_ledger
# Lower-case person or team responsible for this deployment.
SCRIPT_OWNER=
# Use jsonl in screen and journal under systemd. Omit LOG_MODE for local console.
# LOG_MODE=jsonl
# LOG_INSTANCE=playground
# LOG_LEVEL=INFO
# LOG_CONSOLE=true
